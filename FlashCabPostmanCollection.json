                ]
              }
            }
          ]
        },
        {
          "name": "4 - Start Ride",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{rideBaseUrl}}/api/v1/rides/{{rideId}}/start",
            "description": "Run after a ride has been created and assigned, if your service requires a driver assignment."
          },
          "event": [
            {
