            "description": "Run after Register Rider; its test saves the generated UUID to riderServiceRiderId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returned rider ID matches the saved ID', function () { pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('riderServiceRiderId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4 - Update Rider",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{riderBaseUrl}}/api/v1/riders/{{riderServiceRiderId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Taylor Rider Updated\",\n  \"email\": \"taylor.updated@example.com\",\n  \"phone\": \"+15559876543\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Updated rider fields are returned', function () {",
                  "    const responseBody = pm.response.json();",
                  "    pm.expect(responseBody.name).to.eql('Taylor Rider Updated');",
                  "    pm.expect(responseBody.email).to.eql('taylor.updated@example.com');",
                  "    pm.expect(responseBody.updatedAt).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
