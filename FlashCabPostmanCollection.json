              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayBaseUrl}}/api/v1/riders/{{riderId}}",
            "description": "Rider token required; can update only the authenticated Rider profile.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Taylor Rider Updated\",\n  \"email\": \"taylor.updated@example.test\",\n  \"phone\": \"+15559876543\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4 - Delete My Rider Profile",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{gatewayBaseUrl}}/api/v1/riders/{{riderId}}",
            "description": "Destructive: deletes the authenticated Rider profile. This does not delete the Auth account."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204 No Content', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ],
      "description": "Rider profiles are created by Authentication / Sign Up Rider; profile registration is not a separate signup flow."
    },
