  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1 - Sign Up Rider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayBaseUrl}}/auth/signup",
            "description": "Creates the Rider account and profile. The generated email is saved for the Login Rider request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Taylor Rider\",\n  \"email\": \"rider+{{$guid}}@example.test\",\n  \"password\": \"{{testPassword}}\",\n  \"phone\": \"+15557654321\",\n  \"role\": \"RIDER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Signup response is JSON', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test('Profile ID is returned', function () { pm.expect(body.profileId).to.be.a('string').and.not.empty; });",
                  "if (body.profileId) pm.collectionVariables.set('riderId', body.profileId);",
                  "if (body.email) pm.collectionVariables.set('riderEmail', body.email);",
                  "if (body.userId) pm.collectionVariables.set('riderUserId', body.userId);",
                  "if (body.role) pm.expect(body.role).to.eql('RIDER');"
                ]
              }
            }
          ]
        },
        {
          "name": "2 - Login Rider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayBaseUrl}}/auth/login",
            "description": "Stores the Rider Bearer token and profile ID for subsequent protected requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{riderEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Login response is JSON', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test('Bearer token is returned', function () { pm.expect(body.accessToken).to.be.a('string').and.not.empty; });",
                  "if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "if (body.profileId) pm.collectionVariables.set('riderId', body.profileId);",
                  "if (body.userId) pm.collectionVariables.set('riderUserId', body.userId);",
                  "if (body.role) pm.collectionVariables.set('activeRole', body.role);"
                ]
              }
            }
          ]
        },
        {
          "name": "3 - Sign Up Driver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayBaseUrl}}/auth/signup",
            "description": "Creates the Driver account and profile. Driver sign-up requires vehicleType and vehicleNumber.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jordan Driver\",\n  \"email\": \"driver+{{$guid}}@example.test\",\n  \"password\": \"{{testPassword}}\",\n  \"phone\": \"+15551234567\",\n  \"role\": \"DRIVER\",\n  \"vehicleType\": \"SEDAN\",\n  \"vehicleNumber\": \"ABC1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Signup response is JSON', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test('Profile ID is returned', function () { pm.expect(body.profileId).to.be.a('string').and.not.empty; });",
                  "if (body.profileId) pm.collectionVariables.set('driverId', body.profileId);",
                  "if (body.email) pm.collectionVariables.set('driverEmail', body.email);",
                  "if (body.userId) pm.collectionVariables.set('driverUserId', body.userId);",
                  "if (body.role) pm.expect(body.role).to.eql('DRIVER');"
                ]
              }
            }
          ]
        },
        {
          "name": "4 - Login Driver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayBaseUrl}}/auth/login",
            "description": "Stores the Driver Bearer token and profile ID for subsequent protected requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{driverEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Login response is JSON', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test('Bearer token is returned', function () { pm.expect(body.accessToken).to.be.a('string').and.not.empty; });",
                  "if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "if (body.profileId) pm.collectionVariables.set('driverId', body.profileId);",
                  "if (body.userId) pm.collectionVariables.set('driverUserId', body.userId);",
                  "if (body.role) pm.collectionVariables.set('activeRole', body.role);"
                ]
              }
            }
          ]
        }
      ],
      "description": "Signup provisions the associated profile. Login updates the collection accessToken used by all protected requests."
    },
    {
      "name": "Location Service",
      "item": [
        {
          "name": "1 - Update My Driver Location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayBaseUrl}}/api/v1/locations/drivers/update",
            "description": "Driver token required. Sign in as the Driver first; driverId is filled from its signup/login response.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"{{driverId}}\",\n  \"latitude\": 12.9716,\n  \"longitude\": 77.5946\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Location update confirmation', function () { pm.expect(pm.response.text()).to.include('Driver location updated'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2 - Find Nearby Drivers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayBaseUrl}}/api/v1/locations/drivers/nearby?latitude={{latitude}}&longitude={{longitude}}&radiusInKm={{radiusInKm}}",
            "description": "Rider token required. Update a Driver location first so that a driver appears in the nearby results."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        }
      ],
      "description": "Location seeding, reservation, release, and removal are internal/admin operations and are intentionally not exposed through the Gateway."
    },
    {
      "name": "Ride Service",
      "item": [
        {
          "name": "1 - Request Ride",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayBaseUrl}}/api/v1/rides/request",
            "description": "Rider token required. Update a Driver location first; matching is asynchronous through Kafka.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"riderId\": \"{{riderId}}\",\n  \"pickupLatitude\": 12.9716,\n  \"pickupLongitude\": 77.5946,\n  \"pickupAddress\": \"MG Road, Bengaluru\",\n  \"dropLatitude\": 12.975,\n  \"dropLongitude\": 77.599,\n  \"dropAddress\": \"Indiranagar, Bengaluru\",\n  \"vehicleType\": \"SEDAN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test('Estimated fare is returned', function () { pm.expect(body.estimatedFare).to.be.a('number'); });",
                  "const id = body.rideId || body.id;",
                  "pm.test('Ride ID is returned', function () { pm.expect(id).to.be.a('string').and.not.empty; });",
                  "if (id) pm.collectionVariables.set('rideId', String(id));"
                ]
              }
            }
          ]
        },
        {
          "name": "2 - Get Ride By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayBaseUrl}}/api/v1/rides/{{rideId}}",
            "description": "Rider token (owner) or the assigned Driver token required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
        {
          "name": "3 - Get My Rides",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayBaseUrl}}/api/v1/rides/rider/{{riderId}}",
            "description": "Rider token required; only the authenticated Rider profile can be queried."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4 - Start Ride",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{gatewayBaseUrl}}/api/v1/rides/{{rideId}}/start",
            "description": "Assigned Driver token required. Run after matching has assigned a Driver and the ride is ACCEPTED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
        {
          "name": "5 - Complete Ride",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{gatewayBaseUrl}}/api/v1/rides/{{rideId}}/complete",
            "description": "Assigned Driver token required. Run after Start Ride succeeds."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
        {
          "name": "6 - Cancel Ride",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{gatewayBaseUrl}}/api/v1/rides/{{rideId}}/cancel",
            "description": "Rider token required. Use a separate newly created ride when testing cancellation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        }
      ],
      "description": "Use the Rider token for requests, rider ride history, and cancellation; use the assigned Driver token to start and complete rides."
    },
