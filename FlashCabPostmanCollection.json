          "name": "6 - Cancel Ride",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{rideBaseUrl}}/api/v1/rides/{{rideId}}/cancel",
            "description": "Test this with a separate newly-created ride; do not cancel the same ride after completing it."
          },
          "event": [
            {
              "listen": "test",
