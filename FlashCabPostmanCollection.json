    {
      "name": "Rider Service",
      "item": [
        {
          "name": "1 - Register Rider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{riderBaseUrl}}/api/v1/riders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Taylor Rider\",\n  \"email\": \"taylor.rider@example.com\",\n  \"phone\": \"+15557654321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "const responseBody = pm.response.json();",
                  "pm.test('Generated rider ID and timestamps are returned', function () {",
                  "    pm.expect(responseBody.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(responseBody.createdAt).to.be.a('string').and.not.empty;",
                  "    pm.expect(responseBody.updatedAt).to.be.a('string').and.not.empty;",
                  "});",
                  "if (responseBody.id) {",
                  "    pm.collectionVariables.set('riderServiceRiderId', responseBody.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2 - Get All Riders",
          "request": {
            "method": "GET",
            "header": [],
