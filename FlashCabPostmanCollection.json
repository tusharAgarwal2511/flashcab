    {
      "name": "Ride Service",
      "item": [
        {
          "name": "1 - Request Ride",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rideBaseUrl}}/api/v1/rides/request",
            "description": "Creates a ride using the actual rider ID from Rider Service; vehicleType must be a supported value such as SEDAN, SUV, BIKE, etc.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"riderId\": \"{{riderId}}\",\n  \"pickupLatitude\": 12.9716,\n  \"pickupLongitude\": 77.5946,\n  \"pickupAddress\": \"MG Road, Bengaluru\",\n  \"dropLatitude\": 12.975,\n  \"dropLongitude\": 77.599,\n  \"dropAddress\": \"Indiranagar, Bengaluru\",\n  \"vehicleType\": \"SEDAN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "const responseBody = pm.response.json();",
                  "pm.test('Estimated fare is returned', function () { pm.expect(responseBody.estimatedFare).to.be.a('number'); });",
                  "const createdRideId = responseBody.rideId || responseBody.id;",
                  "pm.test('Generated ride ID is returned', function () { pm.expect(createdRideId).to.be.a('string').and.not.empty; });",
                  "if (createdRideId !== undefined && createdRideId !== null) {",
                  "    pm.collectionVariables.set('rideId', String(createdRideId));",
                  "    console.log('Saved rideId:', createdRideId);",
                  "} else {",
                  "    console.warn('No rideId/id property found. Set the rideId collection variable manually.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2 - Get Ride By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rideBaseUrl}}/api/v1/rides/{{rideId}}",
            "description": "Run after Request Ride. The rideId variable is populated from ride creation if response contains rideId or id."
