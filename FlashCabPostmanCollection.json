    {
      "name": "Location Service",
      "item": [
        {
          "name": "1 - Seed Test Drivers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{locationBaseUrl}}/api/v1/locations/drivers/seed?count=10&minLatitude=12.96&maxLatitude=12.98&minLongitude=77.58&maxLongitude=77.61",
            "description": "Seeds Redis locations for actual registered drivers from Driver Service. Register drivers first, then run this request to populate Redis GEO with real driver IDs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Seed confirmation returned', function () { pm.expect(pm.response.text()).to.include('10 drivers added to Redis'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2 - Update Driver Location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{locationBaseUrl}}/api/v1/locations/drivers/update",
            "description": "Updates the location for the actual MongoDB driver ID stored in driverId. The driver must already exist in Driver Service before updating Redis.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"{{driverId}}\",\n  \"latitude\": 12.9716,\n  \"longitude\": 77.5946\n}",
              "options": {
                "raw": {
                  "language": "json"
